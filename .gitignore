# ---------------------------------------------------------------------------
# office365_tools
#
# Two rules matter most here:
#   1. Nothing containing tenant data is ever committed (config/*.json).
#   2. Nothing a script produced is ever committed (out/, log/).
# ---------------------------------------------------------------------------

# Real configuration. Only the *.example.json templates are tracked -- and
# the schema they point at, which describes the shape and holds no tenant.
config/*.json
!config/*.example.json
!config/*.schema.json

# Script output: reports, logs, exports. Reports/ is where the double-click
# launcher puts them, beside itself -- in packaging/ when run from a checkout,
# where it also puts its copy of each tool's settings (packaging/*.xml).
out/
Reports/
/packaging/*.xml
log/
logs/
*.log

# Credentials / secrets that must never be committed.
*.pfx
*.cer
*.key
*.pem
.env
secrets.json

# PowerShell module build/publish output
*.nupkg
*.snupkg
Output/

# Pester / test output
testResults*.xml
coverage*.xml
TestResults/

# Editors and OS
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# Office lock files (SharePoint sync folders love these)
~$*
