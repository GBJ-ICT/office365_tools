# ---------------------------------------------------------------------------
# office365_tools
#
# Two rules matter most here:
#   1. Nothing containing tenant data is ever committed (config/*.json).
#   2. Nothing a script produced is ever committed (out/, log/).
# ---------------------------------------------------------------------------

# Real configuration. Only the *.example.json templates are tracked.
config/*.json
!config/*.example.json

# Script output: reports, logs, exports.
out/
log/
logs/
*.log

# Credentials / secrets that must never be committed.
*.pfx
*.cer
*.key
*.pem
.env
secrets.json

# PowerShell module build/publish output
*.nupkg
*.snupkg
Output/

# Pester / test output
testResults*.xml
coverage*.xml
TestResults/

# Editors and OS
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# Office lock files (SharePoint sync folders love these)
~$*
